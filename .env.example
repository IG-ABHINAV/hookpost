# Configuration reference: http://docs.hookpost.com/configuration/reference

# === Required Settings
DATABASE_URL="postgresql://hookpost-local:hookpost-local-pwd@localhost:5432/hookpost-db-local"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="random string for your JWT secret, make it long"
# Only for a partner SaaS calling /enterprise/*: its own signing secret, 32+
# characters and not JWT_SECRET. Unset, those endpoints refuse every request.
# ENTERPRISE_JWT_SECRET=""

# === This needs to be exactly the URL you're accessing Hookpost on
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"

## Remember to set your public internet IP address in the allow-list for the API token.
##
## Cloudflare is currently required to save things like social media avatars for accounts.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_BUCKETNAME="your-bucket-name"
CLOUDFLARE_BUCKET_URL="https://your-bucket-url.r2.cloudflarestorage.com/"
CLOUDFLARE_REGION="auto"

# === Common optional Settings

## This is a dummy key, you must create your own from Resend.
## If this variable exists, user activation is required.
## If it is commented out, users are activated automatically.
#RESEND_API_KEY="re_your_resend_api_key"
#EMAIL_FROM_ADDRESS=""
#EMAIL_FROM_NAME=""
#DISABLE_REGISTRATION=false

# Where will social media icons be saved - local or cloudflare.
STORAGE_PROVIDER="local"

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#UPLOAD_DIRECTORY=""

# Your upload directory path if you host your files locally, otherwise Cloudflare will be used.
#NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""

# Sign in with Apple (login provider)
# APPLE_APP_BUNDLE_ID: iOS app bundle id (native mobile sign-in). Web sign-in
# (APPLE_CLIENT_ID, the Services ID, with TEAM_ID / KEY_ID / PRIVATE_KEY, the
# .p8 key) is below with the other social logins.
APPLE_APP_BUNDLE_ID=""

# Social Media API Settings
X_URL=""
X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Sign in with Apple, client id is the Services ID identifier
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Optional, comma-separated: Facebook Page ids and Instagram business account
# ids to offer when /me/accounts does not list them (e.g. new Pages Experience).
# META_EXTRA_PAGE_IDS=""
# META_EXTRA_INSTAGRAM_IDS=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_BUSINESS_CLIENT_ID=""
TIKTOK_BUSINESS_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Chrome Extension Settings (for cookie-based platform integrations like Skool)
# Production MUST set this to the Web Store id of the Hookpost extension:
#   EXTENSION_ID="fgbeifijcdbemmpfeipilgdfedpjcjig"
# (https://chromewebstore.google.com/detail/hookpost/fgbeifijcdbemmpfeipilgdfedpjcjig).
# Read at request time by the app layouts; empty hides Skool in Add Channel and
# the app cannot reach the extension. Skool must also be absent from
# HIDDEN_PROVIDERS. tests/smoke/prod.smoke.test.mjs checks both on production.
# Development: the id chrome://extensions shows for the unpacked dev build.
EXTENSION_ID=""

# Misc Settings
# AI provider (libraries/nestjs-libraries/src/openai/ai.provider.ts).
# Default: Gemini on Vertex AI, billed to the Google Cloud project (and its
# credits). AI_PROVIDER=openai moves every AI call back to OpenAI;
# AI_TEXT_PROVIDER / AI_AGENT_PROVIDER / AI_IMAGE_PROVIDER move one kind only.
AI_PROVIDER="vertex"
VERTEX_PROJECT=""
# global serves every current Gemini model
VERTEX_LOCATION="global"
# Service-account key (roles/aiplatform.user only), outside the repo, chmod 600.
VERTEX_CREDENTIALS_FILE=""
# VERTEX_TEXT_MODEL="gemini-3.8-flash"
# VERTEX_AGENT_MODEL=""            # defaults to VERTEX_TEXT_MODEL
# The image model is the newest GA gemini-nano-banana-<v> / gemini-<v>-flash-image, looked up
# from Vertex at startup and every 24h (openai/image.model.ts). AI_IMAGE_MODEL
# is used only when that lookup fails (then gemini-nano-banana-2.1, then
# gemini-3.1-flash-lite-image, then gemini-3.1-flash-image). Only a model priced at
# $0.04 or less per 1K image (image.model.ts IMAGE_MODEL_PRICES) is picked.
# AI_IMAGE_MODEL=""
# VERTEX_FALLBACK_MODELS="gemini-3.5-flash-lite"         # tried on a 429
# VERTEX_IMAGE_FALLBACK_MODELS=""  # tried on a 429; default AI_IMAGE_MODEL + the chain above
# VERTEX_REASONING_EFFORT="low"
# AI_TIMEOUT_MS="120000"
# OpenAI: the fallback provider (and its models when it is selected)
OPENAI_API_KEY=""
# OAuth client configured for the ChatGPT app. Only this client can receive
# verified user email claims for ChatGPT Enterprise domain restrictions.
OPENAI_OAUTH_CLIENT_ID=""
# MCP OAuth Dynamic Client Registration (RFC 7591) redirect-domain allowlist.
# When set (comma separated), POST /oauth/register only accepts redirect_uris
# whose host matches a listed domain or one of its subdomains; unset or empty
# means any client can self-register. Example: the Claude and ChatGPT
# connectors (loopback callbacks such as Claude Code's are always allowed).
# DCR_VERIFIED_DOMAINS="claude.ai,claude.com,chatgpt.com,platform.openai.com"
NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# Leave NOT_SECURED empty in production: session cookies are then httpOnly,
# Secure and SameSite=Lax, and the session token is never sent to a browser in
# a header (apps/backend/src/services/auth/session.cookies.ts). Set it only for
# plain-http development without https on localhost. To turn it off on a
# server that had it, set NOT_SECURED="" rather than deleting the line
# (load-env.ts explains why a deleted key keeps its old value).
# NOT_SECURED=true
API_LIMIT=30 # The limit of the public API hour limit

# When connecting providers that take a self-hosted URL (WordPress, Mastodon,
# Lemmy, Listmonk, Bluesky PDS, etc.) Hookpost fetches that URL server-side and
# blocks requests that resolve to private/internal/loopback/link-local IPs to
# prevent SSRF. Set to true ONLY if your Hookpost instance must reach those
# services on a trusted private network (e.g. same Docker network or VPC).
# DISABLE_SSRF_PROTECTION=false

# Payment settings
FEE_AMOUNT=0.05
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_WEBHOOK_SECRET_CONNECT=""
# 20% off the first month of a new rupee monthly plan charged at checkout:
# the ids of two dashboard-made Subscription Offers, one for UPI and one for
# cards (offer_ + 14 characters). Blank = no offer. See first.month.offer.ts
# and .env.production.example.
RAZORPAY_OFFER_FIRST_MONTH_UPI=""
RAZORPAY_OFFER_FIRST_MONTH_CARD=""
# Trials behind their switch (trial.policy.ts "TRIALS BEHIND A SWITCH"):
# TRIAL_CHECKOUT=on gives a free_posts workspace a card or UPI trial instead
# of a charge at checkout. Off (unset) in production, owner's call. Read at
# build time too, so set it before a frontend build.
# TRIAL_CHECKOUT=""
# Trial length override (trial.policy.ts baseTrialDays): unset = TRIAL_DAYS,
# 0 = no trial for anyone.
# RAZORPAY_TRIAL_DAYS=""
# The domain of the placeholder email a Razorpay customer gets when the
# workspace owner has none (razorpay.service.ts). Default hookpost.local.
# BILLING_EMAIL_DOMAIN=""

# Plans sold on Gumroad (libraries/.../services/gumroad.license.ts). The
# product_id of each Gumroad membership (shown in the License key block on the
# product's Content page), and an API access token (view_sales scope) for the
# daily re-check (where RUN_CRON is on) that ends the plan of a refunded,
# charged-back, failed or cancelled membership. Off (no redeem field, POST
# /billing/gumroad/redeem answers 404) unless a product AND the token are set.
# Needs gumroad-license.migration.sql.
GUMROAD_PRODUCT_STANDARD=""
GUMROAD_PRODUCT_PRO=""
GUMROAD_ACCESS_TOKEN=""

# The owner's sale alerts (libraries/.../services/owner.sales.alert.service.ts):
# one plain-text email per money event (trial started, first charge, renewal,
# plan change, cancellation, failing or halted renewal, refund, Gumroad
# redeem and membership changes), sent through RESEND_API_KEY. One address or
# several separated by commas. Empty: no alerts. Customer emails are not
# affected and never go here.
OWNER_SALES_ALERT_EMAIL=""

# Developer Settings
NX_ADD_PLUGINS=false
IS_GENERAL="true" # required for now
NEXT_PUBLIC_HOOKPOST_OAUTH_DISPLAY_NAME="Authentik"
NEXT_PUBLIC_HOOKPOST_OAUTH_LOGO_URL="https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png"
HOOKPOST_GENERIC_OAUTH="false"
HOOKPOST_OAUTH_URL="https://auth.example.com"
HOOKPOST_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
HOOKPOST_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
HOOKPOST_OAUTH_USERINFO_URL="https://authentik.example.com/application/o/userinfo"
HOOKPOST_OAUTH_CLIENT_ID=""
HOOKPOST_OAUTH_CLIENT_SECRET=""
# HOOKPOST_OAUTH_SCOPE="openid profile email" # default values

# Short Link Service Settings
# DUB_TOKEN="" # Your self-hosted Dub API token
# DUB_API_ENDPOINT="https://api.dub.co" # Your self-hosted Dub API endpoint
# DUB_SHORT_LINK_DOMAIN="dub.sh" # Your self-hosted Dub domain

# SHORT_IO_SECRET_KEY="" # Your Short.io API secret key

# KUTT_API_KEY="" # Your Kutt.it API key
# KUTT_API_ENDPOINT="https://kutt.it/api/v2" # Your self-hosted Kutt API endpoint
# KUTT_SHORT_LINK_DOMAIN="kutt.it" # Your self-hosted Kutt domain

# LINK_DRIP_API_KEY="" # Your LinkDrip API key
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/" # Your self-hosted LinkDrip API endpoint
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink" # Your self-hosted LinkDrip domain

# Provider visibility / migration
# HIDDEN_PROVIDERS="tiktok" # comma-separated identifiers hidden from the add-channel screen
# MIGRATE_PROVIDERS="tiktok:tiktok-business" # comma-separated "old:new" pairs, a reconnect of "old" goes through "new" and the channel is migrated in place

# Arms missingPostWorkflow, the hourly sweep that re-queues a QUEUE post whose
# Temporal workflow was lost (two-day window, so it never republishes stale
# content). This was unset in production until 2026-09-10, which meant the
# safety net had never run there. Set it on any instance that owns the cron
# workflows - exactly one, if you ever run more than one backend.
RUN_CRON=true

# Every 6 h (where RUN_CRON is on), removes two-step connect placeholders that
# nobody finished within 24 h: a Facebook, Instagram or YouTube login whose
# page was never picked, with no posts. Off unless "true": the first run
# deletes the placeholders already in the database.
# PLACEHOLDER_SWEEP=true

# Daily at 04:00 UTC (where RUN_CRON is on): media retention after a plan
# ends (MediaRetentionService, trial.policy.ts). A workspace without a plan
# is told on day 0, reminded 7 days before, and on day 30 the media of its
# unpublished posts and its media library uploads are removed from storage.
# Dry run (logs only: no row, email or deletion) unless exactly "true".
# Apply media-retention.migration.sql first.
# MEDIA_RETENTION_ENABLED=true

# ---------------------------------------------------------------------------
# api.market products (apps/backend/src/marketplace-api, /api/mkt/v1/<product>)
# ---------------------------------------------------------------------------
# Off while every MKT_GATEWAY_SECRETS_* is empty: each /api/mkt call is then
# refused with 401 before anything is read. Apply
# marketplace-account.migration.sql before setting one.
#
# MKT_GATEWAY_SECRETS_<PRODUCT>: the shared secret the product's api.market
# Source sends in the header x-hookpost-gateway (Source auth: API Key). A
# comma list, current first; during a rotation both, and the old one is
# removed once redis-cli shows no mkt:secrethits:<product>:<its sha256
# prefix>:* for 7 days. At least 32 characters each (openssl rand -hex 32).
MKT_GATEWAY_SECRETS_SOCIAL=""
MKT_GATEWAY_SECRETS_LINKEDIN=""
MKT_GATEWAY_SECRETS_X=""
MKT_GATEWAY_SECRETS_VALIDATE=""
# MKT_PLAN_TOKEN_HASHES: <sha256 hex of a plan token>=<product>:<plan>, comma
# separated, one per api.market pricing plan that sends a token (optional
# for Social, whose plans are named by x-magicapi-plan: MAGICAPI_PLAN_NAMES
# in marketplace.gateway.ts; revoking a Social plan means removing its name
# there, not only its hash here). The token itself goes only into
# that plan's custom headers ({"x-hookpost-plan": "<token>"}); .env holds its
# hash (printf %s "$TOKEN" | shasum -a 256). Plans: social:trial|standard|pro,
# linkedin:trial|creator|agency, x:trial|basic|pro,
# validate:trial|starter|scale (libraries/nestjs-libraries/src/marketplace/
# marketplace.plans.ts). A token stays valid for subscribers of the plan
# version it was set on: never reuse one for another plan.
MKT_PLAN_TOKEN_HASHES=""
# Kill switch: products refused at once (503) and refused at publish time by
# the orchestrator (set it in the orchestrator's environment too), e.g. "x".
MKT_DISABLED_PRODUCTS=""
# Networks the Social Scheduler sells (default: x,linkedin,threads,facebook,
# instagram,youtube,pinterest,discord,slack). Narrow it to stop selling one.
# MKT_SOCIAL_PROVIDERS=""
# What every X trial together may cost a day, in US$ (default 3). Past it,
# trial X posts get 503 trial_capacity, not billed.
# MKT_TRIAL_X_DAILY_USD="3"
# Per-subscriber token buckets, calls a second (defaults 2 and 10).
# MKT_RATE_WRITE_PER_SEC="2"
# MKT_RATE_READ_PER_SEC="10"
# The same products through other marketplaces (one gateway, an adapter per
# marketplace: libraries/nestjs-libraries/src/marketplace/marketplace.adapters.ts).
# RapidAPI: the proxy secret of each product's RapidAPI API (Studio > Hub
# Listing > Gateway > X-RapidAPI-Proxy-Secret), comma list for a rotation.
# Empty: RapidAPI calls to that product are refused (401).
MKT_RAPIDAPI_SECRETS_SOCIAL=""
MKT_RAPIDAPI_SECRETS_LINKEDIN=""
MKT_RAPIDAPI_SECRETS_X=""
MKT_RAPIDAPI_SECRETS_VALIDATE=""
# X-RapidAPI-Subscription to our plan. Default per product: BASIC = trial,
# PRO = the first paid plan, ULTRA and MEGA = the top one. Overrides, e.g.
# "social:PRO=pro,social:CUSTOM=standard" (a product listed here uses only these).
# MKT_RAPIDAPI_PLANS=""
# The custom quota object credits are reported in (X-RapidAPI-Billing: Credits=N).
# MKT_RAPIDAPI_BILLING_OBJECT="Credits"
# Any other marketplace that forwards with a key: its name here, then
# MKT_KEYED_<NAME>_SECRETS_<PRODUCT> (the key it sends in
# x-hookpost-marketplace-key, next to x-hookpost-marketplace: <name>),
# _LABEL, _USER_HEADER (the buyer's id; without it only the validator can be
# sold there), _PLAN_HEADER + _PLANS ("social:Basic=trial,..."), or
# _DEFAULT_PLAN_<PRODUCT>, and _BILLING_HEADER (a response header with the credits).
# MKT_KEYED_MARKETPLACES=""

