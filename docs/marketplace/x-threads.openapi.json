{
  "openapi": "3.1.0",
  "info": {
    "title": "X Thread API",
    "version": "1.0.0",
    "description": "Schedule X threads as an array of tweets, with a cost estimate before anything is sent.\nPOST /threads/estimate needs no connected account: it counts each tweet the way X does (280 characters, 4,000 on X Premium), flags links and media problems, and prices the thread.\n\nCredits: 2 per tweet; 20 per tweet that has a link (X charges more for those). Links are refused unless link_policy is \"allow\". Trials take threads of up to 5 tweets and no links. Everything else costs 0. Each response reports what it used in X-Magicapi-Billing.",
    "contact": {
      "name": "Hookstep support",
      "email": "support@hookstep.in",
      "url": "https://hookpost.hookstep.in"
    }
  },
  "servers": [
    {
      "url": "https://hookpost.hookstep.in/api/mkt/v1/x"
    }
  ],
  "tags": [
    {
      "name": "X Threads"
    }
  ],
  "paths": {
    "/threads/estimate": {
      "post": {
        "tags": [
          "X Threads"
        ],
        "operationId": "estimateThread",
        "summary": "Check and price a thread",
        "description": "Needs no connected account. 0 credits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThreadEstimate"
              },
              "example": {
                "tweets": [
                  {
                    "text": "Thread: how we cut our build time in half 🧵"
                  },
                  {
                    "text": "Step 1: cache the dependencies.",
                    "media_count": 1
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The check.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "credits": {
                      "type": "integer"
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tweets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TweetCheck"
                      }
                    },
                    "thread_cap": {
                      "type": "integer"
                    },
                    "links_included": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid. Nothing was done or billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/threads": {
      "post": {
        "tags": [
          "X Threads"
        ],
        "operationId": "createThread",
        "summary": "Schedule a thread",
        "description": "Credits: the sum over tweets (2, or 20 with a link). Up to 50 tweets a day per X account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Thread"
              },
              "example": {
                "channel_id": "clx123channel",
                "tweets": [
                  {
                    "text": "Thread: how we cut our build time in half 🧵"
                  },
                  {
                    "text": "Step 1: cache the dependencies."
                  }
                ],
                "schedule_at": "2026-11-02T09:30:00Z",
                "who_can_reply": "everyone"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid. Nothing was done or billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Over a plan limit (credits, channels, storage, or a network the plan does not include). Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such channel, post or media in your workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicts with the current state (already published, duplicate post, same call still running).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Paused or at capacity. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
