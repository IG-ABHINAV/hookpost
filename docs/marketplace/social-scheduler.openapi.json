      "post": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "createPost",
        "summary": "Schedule a post on one or more channels",
        "description": "The same content goes to every channel; content[0] is the post and content[1..] its thread replies (X tweets, Threads replies). Credits: 1 per channel, X 2 per tweet or 20 per tweet with a link. Held when accepted and not returned on cancel.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocialPost"
              },
              "example": {
                "channels": [
                  {
                    "id": "clx123channel"
                  },
                  {
                    "id": "clx456channel",
                    "settings": {
                      "who_can_reply_post": "everyone"
                    }
                  }
                ],
                "content": [
                  {
                    "text": "We shipped a new release today.",
                    "media_ids": []
                  }
                ],
                "schedule_at": "2026-11-02T09:30:00Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
