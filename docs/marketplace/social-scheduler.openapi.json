        ],
        "operationId": "findSlot",
        "summary": "Next open time slot of a channel",
        "description": "The next of the channel's posting times that has no post yet. 0 credits.",
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "description": "Channel id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The slot.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channel_id": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such channel, post or media in your workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "listNotifications",
        "summary": "Workspace notifications",
        "description": "Publishing errors and notices of your workspace, newest first, 100 a page. 0 credits.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page, from 0.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The notifications.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "notifications": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "getUsage",
        "summary": "Credits, channels and storage used",
        "description": "Our own counters for the current 28-day window, which starts at your first call and need not match api.market's month. api.market's dashboard is the billing record. 0 credits.",
        "responses": {
          "200": {
            "description": "Usage.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A stable code, e.g. quota_exceeded, channel_not_found, invalid_thread.",
            "example": "quota_exceeded"
          },
          "message": {
            "description": "What went wrong, for a person.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "channel_id": {
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "media_id": {
            "type": "string"
          }
        }
      },
      "ConnectLink": {
        "type": "object",
        "required": [
          "provider",
          "url",
          "expires_in"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "example": "linkedin"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Open this in a browser and sign in to your own account. Treat it like a password: anyone who opens it within the hour connects their account to your workspace."
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "example": "x"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "disabled": {
            "type": "boolean"
          },
          "needs_reconnect": {
            "type": "boolean",
            "description": "The network refused the token; connect again with ?reconnect=<id>."
          },
          "pending_page_pick": {
            "type": "boolean",
            "description": "Login done but no page or account picked yet."
          }
        }
      },
      "ChannelList": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          "included": {
            "type": "integer",
            "description": "Channels your plan includes."
          }
        }
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "string"
          }
        }
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "bytes": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        }
      },
      "MediaUpload": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "JPEG, PNG, GIF or WebP up to 10 MB, or MP4 up to 200 MB (files over 95 MB: use /media/from-url)."
          }
        }
      },
      "MediaFromUrl": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "A public http(s) URL of the image or video."
          }
        }
      },
      "AcceptedPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Use it with GET and DELETE."
          },
          "channel_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "queued",
              "draft"
            ]
          },
          "publish_at": {
            "type": "string",
            "format": "date-time"
          },
          "credits": {
            "type": "integer"
          }
        }
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AcceptedPost"
            }
          },
          "credits_charged": {
            "type": "integer"
          }
        }
      },
      "PostItemStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "published",
              "error",
              "draft"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The live post, once published."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PostStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PostItemStatus"
          },
          {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string"
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publish_at": {
                "type": "string",
                "format": "date-time"
              },
              "replies": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PostItemStatus"
                },
                "description": "Thread replies, in order."
              }
            }
          }
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "plan_name": {
            "type": "string"
          },
          "window_start": {
            "type": "string",
            "format": "date-time"
          },
          "window_end": {
            "type": "string",
            "format": "date-time"
          },
          "credits_included": {
            "type": "integer"
          },
          "credits_used": {
            "type": "integer"
          },
          "channels_included": {
            "type": "integer"
          },
          "channels_used": {
            "type": "integer"
          },
          "storage_included_bytes": {
            "type": "integer"
          },
          "storage_used_bytes": {
            "type": "integer"
          },
          "schedule_horizon_days": {
            "type": "integer"
          },
          "x_included": {
            "type": "boolean"
          },
          "x_links_included": {
            "type": "boolean"
          },
          "thread_cap": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "SocialPost": {
        "type": "object",
        "required": [
          "channels",
          "content",
          "schedule_at"
        ],
        "properties": {
          "channels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Channel id from GET /channels."
                },
                "settings": {
                  "type": "object",
                  "description": "The network's settings (GET /providers lists each one's schema), e.g. Pinterest board, YouTube title. Discord: channel is the id of a channel in the server you connected; any other is refused (400 channel_not_in_server)."
                }
              }
            }
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Plain text, posted as typed."
                },
                "media_ids": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "schedule_at": {
            "type": "string",
            "description": "When to publish: an ISO 8601 time with a zone (\"2026-11-02T09:30:00Z\"), \"now\", or \"draft\". Trials schedule up to 7 days ahead, paid plans up to 35.",
            "example": "2026-11-02T09:30:00Z"
          },
          "link_policy": {
            "type": "string",
            "enum": [
              "reject",
              "allow"
            ],
            "default": "reject",
            "description": "X only. \"reject\" (the default) refuses a tweet with a link with a 400, so you are never charged by surprise. \"allow\" posts it at 20 credits a tweet (X charges more for posts with links)."
          }
        }
      }
    }
  }
}
