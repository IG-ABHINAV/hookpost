{
  "openapi": "3.1.0",
  "info": {
    "title": "Hookpost Social Scheduler API",
    "version": "1.0.0",
    "description": "Schedule one post to many social networks in one call: LinkedIn, X, Threads, Facebook, Instagram, YouTube, Pinterest, Discord and Slack.\nConnect each account with a sign-in link (GET /connect/{provider}); upload media; create posts and threads; read their status.\n\nCredits: 1 per channel a post goes to; on X, 2 per tweet, or 20 per tweet that has a link (X charges more for those; links are refused unless link_policy is \"allow\"). Everything else costs 0. Each response reports what it used in X-Magicapi-Billing.\nThe 7-day trial: 10 credits, 1 channel, no X. Paid plans include X.",
    "contact": {
      "name": "Hookstep support",
      "email": "support@hookstep.in",
      "url": "https://hookpost.hookstep.in"
    }
  },
  "servers": [
    {
      "url": "https://hookpost.hookstep.in/api/mkt/v1/social"
    }
  ],
  "tags": [
    {
      "name": "Social Scheduler"
    }
  ],
  "paths": {
    "/providers": {
      "get": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "listProviders",
        "summary": "Networks, limits and settings",
        "description": "Every network this API posts to, with its character limit, media rules, credits and the settings it takes. Needs no connected account. 0 credits.",
        "responses": {
          "200": {
            "description": "The networks.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "identifier": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "max_chars": {
                            "type": "integer"
                          },
                          "counting": {
                            "type": "string"
                          },
                          "media": {
                            "type": [
                              "object",
                              "null"
                            ]
                          },
                          "connect": {
                            "type": "boolean"
                          },
                          "picks_page_after_login": {
                            "type": "boolean"
                          },
                          "credits": {
                            "type": "object"
                          },
                          "included_in_plan": {
                            "type": "boolean"
                          },
                          "settings": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "description": "JSON Schema of the network's settings (channels[].settings)."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/connect/{provider}": {
      "get": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "getConnectLinkForProvider",
        "summary": "Get a link to connect an account",
        "description": "Returns a sign-in link for your own account on the network. Open it in a browser; when it says \"connected\", the channel is in GET /channels. The link works once, for an hour, and acts like a password. 0 credits.",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "A network from GET /providers, e.g. linkedin, x, threads.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reconnect",
            "in": "query",
            "required": false,
            "description": "A channel id: connect that channel again (after needs_reconnect).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The link.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectLink"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid. Nothing was done or billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Over a plan limit (credits, channels, storage, or a network the plan does not include). Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such channel, post or media in your workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The network did not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
