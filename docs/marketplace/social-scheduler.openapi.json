    "/posts": {
      "get": {
        "tags": [
          "Social Scheduler"
        ],
        "operationId": "listPosts",
        "summary": "List posts in a time range",
        "description": "Posts publishing between from and to (at most 92 days; default: the last 7 and next 35 days). 0 credits.",
