{
  "openapi": "3.1.0",
  "info": {
    "title": "LinkedIn Carousel & Post API",
    "version": "1.0.0",
    "description": "Turn 2 to 20 images into a LinkedIn-ready PDF carousel, and publish carousels, posts with an image or video, and text posts to LinkedIn personal profiles.\nPOST /carousels/render needs no connected account. Posting needs your LinkedIn profile connected once (GET /connect). Company Pages are not supported yet.\n\nCredits: 1 per render, 1 per carousel or post. Everything else costs 0. Each response reports what it used in X-Magicapi-Billing.",
    "contact": {
      "name": "Hookstep support",
      "email": "support@hookstep.in",
      "url": "https://hookpost.hookstep.in"
    }
  },
  "servers": [
    {
      "url": "https://hookpost.hookstep.in/api/mkt/v1/linkedin"
    }
  ],
  "tags": [
    {
      "name": "LinkedIn"
    }
  ],
  "paths": {
    "/carousels/render": {
      "post": {
        "tags": [
          "LinkedIn"
        ],
        "operationId": "renderCarousel",
        "summary": "Render images as a LinkedIn carousel PDF",
        "description": "One page per image, in order, fitted on white. Square 1080x1080 or portrait 1080x1350 (default). Needs no connected account. The PDF link works for 7 days. 1 credit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CarouselRender"
              },
              "example": {
                "images": [
                  "https://example.com/slide-1.png",
                  "https://example.com/slide-2.png"
                ],
                "title": "Five lessons from our launch",
                "size": "portrait"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The PDF.",
            "headers": {
              "X-Magicapi-Billing": {
                "description": "Credits this call used, as api.market bills them (API=N;). Reads are API=0;.",
                "schema": {
                  "type": "string",
                  "example": "API=1;"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "pdf_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "pages": {
                      "type": "integer"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid. Nothing was done or billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Over a plan limit (credits, channels, storage, or a network the plan does not include). Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such channel, post or media in your workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Over 50 MB of images.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many calls, or a daily network limit. Not billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/carousels": {
      "post": {
        "tags": [
          "LinkedIn"
        ],
        "operationId": "createCarousel",
        "summary": "Publish a document carousel",
