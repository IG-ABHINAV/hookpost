        "operationId": "getConnectLink",
        "summary": "Get a link to connect your LinkedIn account",
        "description": "Returns a sign-in link for your own account on the network. Open it in a browser; when it says \"connected\", the channel is in GET /channels. The link works once, for an hour, and acts like a password. 0 credits.",
        "parameters": [
          {
            "name": "reconnect",
            "in": "query",
            "required": false,
            "description": "A channel id: connect that channel again (after needs_reconnect).",
