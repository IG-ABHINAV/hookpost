  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A stable code, e.g. quota_exceeded, channel_not_found, invalid_thread.",
            "example": "quota_exceeded"
          },
          "message": {
            "description": "What went wrong, for a person.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "channel_id": {
            "type": "string"
          },
          "post_id": {
            "type": "string"
          },
          "media_id": {
            "type": "string"
          }
        }
      },
      "ConnectLink": {
        "type": "object",
        "required": [
          "provider",
          "url",
          "expires_in"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "example": "linkedin"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Open this in a browser and sign in to your own account. Treat it like a password: anyone who opens it within the hour connects their account to your workspace."
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "example": "x"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "disabled": {
            "type": "boolean"
          },
          "needs_reconnect": {
            "type": "boolean",
            "description": "The network refused the token; connect again with ?reconnect=<id>."
          },
          "pending_page_pick": {
            "type": "boolean",
            "description": "Login done but no page or account picked yet."
          }
        }
      },
      "ChannelList": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          "included": {
            "type": "integer",
            "description": "Channels your plan includes."
          }
        }
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "string"
          }
        }
      },
      "Media": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "bytes": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        }
      },
      "MediaUpload": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "JPEG, PNG, GIF or WebP up to 10 MB, or MP4 up to 200 MB (files over 95 MB: use /media/from-url)."
          }
        }
      },
      "MediaFromUrl": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "A public http(s) URL of the image or video."
          }
        }
      },
      "AcceptedPost": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Use it with GET and DELETE."
          },
          "channel_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "queued",
              "draft"
            ]
          },
          "publish_at": {
            "type": "string",
            "format": "date-time"
          },
          "credits": {
            "type": "integer"
          }
        }
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AcceptedPost"
            }
          },
          "credits_charged": {
            "type": "integer"
          }
        }
      },
      "PostItemStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "published",
              "error",
              "draft"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The live post, once published."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PostStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PostItemStatus"
          },
          {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string"
              },
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publish_at": {
                "type": "string",
                "format": "date-time"
              },
              "replies": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PostItemStatus"
                },
                "description": "Thread replies, in order."
              }
            }
          }
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "plan_name": {
            "type": "string"
          },
          "window_start": {
            "type": "string",
            "format": "date-time"
          },
          "window_end": {
            "type": "string",
            "format": "date-time"
          },
          "credits_included": {
            "type": "integer"
          },
          "credits_used": {
            "type": "integer"
          },
          "channels_included": {
            "type": "integer"
          },
          "channels_used": {
            "type": "integer"
          },
          "storage_included_bytes": {
            "type": "integer"
          },
          "storage_used_bytes": {
            "type": "integer"
          },
          "schedule_horizon_days": {
            "type": "integer"
          },
          "x_included": {
            "type": "boolean"
          },
          "x_links_included": {
            "type": "boolean"
          },
          "thread_cap": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "CarouselRender": {
        "type": "object",
        "required": [
          "images"
        ],
        "properties": {
          "images": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "string"
            },
            "description": "Image URLs (public http(s)) or media ids from POST /media, in page order. JPEG, PNG, GIF or WebP, 50 MB in all."
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "size": {
            "type": "string",
            "enum": [
              "square",
              "portrait"
            ],
            "default": "portrait"
          }
        }
      },
      "LinkedInCarousel": {
        "type": "object",
        "required": [
          "channel_id",
          "title",
          "images",
          "text",
          "schedule_at"
        ],
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "The document title LinkedIn shows."
          },
          "images": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "string"
            },
            "description": "Image URLs or media ids, in page order."
          },
          "text": {
            "type": "string",
            "maxLength": 3000
          },
          "schedule_at": {
            "type": "string",
            "description": "When to publish: an ISO 8601 time with a zone (\"2026-11-02T09:30:00Z\"), \"now\", or \"draft\". Trials schedule up to 7 days ahead, paid plans up to 35.",
            "example": "2026-11-02T09:30:00Z"
          }
        }
      },
      "LinkedInPost": {
        "type": "object",
        "required": [
          "channel_id",
          "text",
          "schedule_at"
        ],
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 3000
          },
          "media_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            },
            "description": "Images, or one video."
          },
          "schedule_at": {
            "type": "string",
            "description": "When to publish: an ISO 8601 time with a zone (\"2026-11-02T09:30:00Z\"), \"now\", or \"draft\". Trials schedule up to 7 days ahead, paid plans up to 35.",
            "example": "2026-11-02T09:30:00Z"
          }
        }
      }
    }
  }
}
